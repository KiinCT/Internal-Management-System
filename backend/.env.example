NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:4200

MONGODB_URI=mongodb://localhost:27017/work_mgmt

# Đổi các secret này khi triển khai thật (chuỗi ngẫu nhiên >= 32 ký tự)
JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_chars
JWT_REFRESH_EXPIRES_IN=7d

UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

SEED_ADMIN_EMAIL=admin@demo.com
SEED_ADMIN_PASSWORD=Admin@123
